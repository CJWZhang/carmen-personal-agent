{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "coverage"],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "id",
          "sender",
          "subject",
          "body",
          "url",
          "ts",
          "channel",
          "thread_id",
          "kind",
          "status",
          "participants",
          "related_keys",
          "metadata"
        ],
        "properties": {
          "source": {
            "type": "string",
            "enum": ["slack", "gmail", "calendar", "github"]
          },
          "id": {"type": "string", "minLength": 1, "maxLength": 512},
          "sender": {"type": "string", "maxLength": 512},
          "subject": {"type": "string", "maxLength": 2000},
          "body": {"type": "string", "maxLength": 20000},
          "url": {"type": "string", "maxLength": 4096, "pattern": "^(|https?://)"},
          "ts": {"type": "string", "maxLength": 128},
          "channel": {"type": "string", "maxLength": 512},
          "thread_id": {"type": "string", "maxLength": 512},
          "kind": {"type": "string", "maxLength": 128},
          "status": {
            "type": "string",
            "enum": ["open", "waiting", "done"]
          },
          "participants": {
            "type": "array",
            "maxItems": 100,
            "items": {"type": "string", "maxLength": 256}
          },
          "related_keys": {
            "type": "array",
            "maxItems": 100,
            "items": {"type": "string", "maxLength": 512}
          },
          "metadata": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repository", "repo", "number", "reason", "state", "note",
              "response_status", "organizer", "kind", "deadline_at", "expires_at",
              "latest_activity_at", "next_action", "review_state", "ci_state",
              "mergeable_state", "resolution_evidence", "conversation_id", "cancelled",
              "review_requested", "assigned", "is_draft", "has_unresolved_threads",
              "ci_passing", "mergeable", "user_replied_after_ask", "needs_decision",
              "series_id", "optional", "historical_instances", "historical_accepted",
              "historical_declined", "historical_tentative", "historical_no_response",
              "historical_attended", "historical_missed"
            ],
            "properties": {
              "repository": {"type": "string", "maxLength": 512},
              "repo": {"type": "string", "maxLength": 512},
              "number": {"type": "string", "maxLength": 64},
              "reason": {"type": "string", "maxLength": 4096},
              "state": {"type": "string", "maxLength": 128},
              "note": {"type": "string", "maxLength": 4096},
              "response_status": {"type": "string", "maxLength": 128},
              "organizer": {"type": "string", "maxLength": 512},
              "kind": {"type": "string", "maxLength": 128},
              "deadline_at": {"type": "string", "maxLength": 128},
              "expires_at": {"type": "string", "maxLength": 128},
              "latest_activity_at": {"type": "string", "maxLength": 128},
              "next_action": {"type": "string", "maxLength": 128},
              "review_state": {"type": "string", "maxLength": 128},
              "ci_state": {"type": "string", "maxLength": 128},
              "mergeable_state": {"type": "string", "maxLength": 128},
              "resolution_evidence": {"type": "string", "maxLength": 4096},
              "conversation_id": {"type": "string", "maxLength": 512},
              "series_id": {"type": "string", "maxLength": 512},
              "cancelled": {"type": "boolean"},
              "review_requested": {"type": "boolean"},
              "assigned": {"type": "boolean"},
              "is_draft": {"type": "boolean"},
              "has_unresolved_threads": {"type": "boolean"},
              "ci_passing": {"type": "boolean"},
              "mergeable": {"type": "boolean"},
              "user_replied_after_ask": {"type": "boolean"},
              "needs_decision": {"type": "boolean"},
              "optional": {"type": "boolean"},
              "historical_instances": {"type": "integer", "minimum": 0, "maximum": 10000},
              "historical_accepted": {"type": "integer", "minimum": 0, "maximum": 10000},
              "historical_declined": {"type": "integer", "minimum": 0, "maximum": 10000},
              "historical_tentative": {"type": "integer", "minimum": 0, "maximum": 10000},
              "historical_no_response": {"type": "integer", "minimum": 0, "maximum": 10000},
              "historical_attended": {"type": "integer", "minimum": 0, "maximum": 10000},
              "historical_missed": {"type": "integer", "minimum": 0, "maximum": 10000}
            }
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "status", "detail"],
        "properties": {
          "source": {
            "type": "string",
            "enum": ["slack", "gmail", "calendar", "github"]
          },
          "status": {
            "type": "string",
            "enum": ["ok", "empty", "unavailable", "error"]
          },
          "detail": {"type": "string", "maxLength": 2000}
        }
      }
    }
  }
}
