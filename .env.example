# Public HTTPS URL assigned to the web service.
CARMEN_PUBLIC_BASE_URL=https://your-service.example.com

# Railway Postgres connection string.
DATABASE_URL=postgresql://user:password@host:5432/carmen

# Slack app credentials. Never commit real values.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CARMEN_TOKEN_ENCRYPTION_KEY=

# Hosted/remote inference is optional and separate from local Ollama or MLX.
CARMEN_MODEL_PROVIDER=openai-compatible
CARMEN_MODEL_BASE_URL=https://api.openai.com/v1
CARMEN_MODEL_API_KEY=
CARMEN_MODEL_NAME=

# Optional first-party read connectors. When a source is authorized here,
# CARMEN_CONNECTOR_MODE=auto uses the provider API directly. Unconfigured
# sources retain the Codex connector bridge as a compatibility fallback.
CARMEN_CONNECTOR_MODE=auto
CARMEN_SLACK_USER_TOKEN=
CARMEN_GOOGLE_CLIENT_ID=
CARMEN_GOOGLE_CLIENT_SECRET=
CARMEN_GOOGLE_REFRESH_TOKEN=
# Short-lived access token alternative for local Google development only.
CARMEN_GOOGLE_ACCESS_TOKEN=
CARMEN_GITHUB_TOKEN=
CARMEN_GITHUB_USERNAME=

# Least-privilege defaults for the v0.1 Slack app.
SLACK_BOT_SCOPES=commands,chat:write,im:write
SLACK_USER_SCOPES=channels:history,groups:history,im:history,mpim:history
